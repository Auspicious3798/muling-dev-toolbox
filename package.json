{
  "name": "muling-environment-box",
  "version": "2.1.4",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k -n VITE,ELECTRON \"npm run dev\" \"electron .\"",
    "electron:dev:debug": "cross-env NODE_ENV=development OPEN_DEVTOOLS=true concurrently -k -n VITE,ELECTRON \"npm run dev\" \"electron .\"",
    "electron:build": "node scripts/build.cjs",
    "sign:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "sign:dev-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-dev-cert.ps1"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.7",
    "mitt": "^3.0.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.muling.dev-toolbox",
    "productName": "沐柠环境盒",
    "artifactName": "${productName}-Setup-${version}.exe",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "public/resources/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "config/**/*",
      "public/resources/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "沐柠环境盒",
      "artifactName": "MulingEnvBox-Setup-${version}.exe",
      "include": "installer.nsh"
    },
    "npmRebuild": false
  },
  "description": "沙箱式 Windows 开发环境管理工具：一键安装与切换 JDK、Python、MySQL、Redis 等，不写系统环境变量。",
  "author": {
    "name": "Auspicious3798",
    "email": "taxuexunmei3798@126.com"
  },
  "license": "MIT"
}
